# ==============================================================================
# PKC EVENTS - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for development, or .env.production for server deployments.
# ==============================================================================

# 1. MongoDB Connection
# Required for blog management, dynamic content, and contact submissions.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/pkc_events?retryWrites=true&w=majority"

# 2. Admin Credentials and JWT Secret
# Used for the administrative dashboard authentication (/admin).
ADMIN_DEFAULT_EMAIL="admin@pkcevents.com"
ADMIN_DEFAULT_PASSWORD="YourStrongAdminPasswordHere!"
ADMIN_JWT_SECRET="generate-a-strong-random-secret-key-at-least-32-chars"

# 3. AWS S3 Credentials (For Media & File Uploads)
# Used by /api/upload to upload gallery, blog, and service assets to AWS S3.
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="pkcevents-storage"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. Google Places API Key
# Used by /api/google-reviews to fetch live 5-star customer ratings and reviews.
GOOGLE_PLACES_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# 5. Public Website & Analytics Settings
# Publicly accessible client-side settings (prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL="https://pkcevents.com"
NEXT_PUBLIC_GTM_ID="GTM-NHGJG7MJ"
NEXT_PUBLIC_GA_ID="G-ZRG45NV821"
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER="918138002333"
